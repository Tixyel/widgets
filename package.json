{
  "name": "tixyel",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalogs": {
      "build": {
        "vite": "^8.0.0",
        "rollup-plugin-dts": "^6.4.0",
        "rollup": "^4.59.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --ui stream",
    "build:client": "turbo run build -F @tixyel/streamelements build --ui stream",
    "build:cli": "turbo run build -F @tixyel/cli build --ui stream",
    "version": "bunx --bun changeset version && git add --all",
    "release": "bun run build && bunx --bun changeset publish",
    "check-types": "turbo run check-types --ui stream",
    "cli": "bun run -C packages/cli dev",
    "watch": "turbo run build --watch",
    "lint": "turbo run lint",
    "format": "oxfmt --write"
  },
  "dependencies": {
    "turbo": "^2.8.17"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@happy-dom/global-registrator": "^20.8.4",
    "@napi-rs/canvas": "^0.1.96",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.41.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.6"
}
