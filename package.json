{
  "name": "tixyel",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "turbo": "^2.7.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@happy-dom/global-registrator": "^20.3.4",
    "@napi-rs/canvas": "^0.1.88",
    "@types/bun": "^1.3.6",
    "@types/node": "^24.10.9",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.0",
    "rollup-plugin-dts": "^6.3.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --ui stream",
    "build:client": "turbo run build -F @tixyel/streamelements build --ui stream",
    "build:cli": "turbo run build -F @tixyel/cli build --ui stream",
    "check-types": "turbo run check-types --ui stream",
    "lint": "turbo run lint",
    "watch": "turbo run build --watch",
    "prettier": "prettier --write packages/",
    "version": "bunx --bun changeset version && git add --all",
    "release": "bun run build && bunx --bun changeset publish"
  },
  "packageManager": "bun@1.3.6"
}
