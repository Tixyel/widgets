{
  "name": "tixyel",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalogs": {
      "build": {
        "vite": "^8.0.8",
        "rollup-plugin-dts": "^6.4.1",
        "rollup": "^4.60.1"
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --ui stream",
    "build:client": "turbo run build -F @tixyel/streamelements build --ui stream",
    "build:cli": "turbo run build -F @tixyel/cli build --ui stream",
    "version": "bunx --bun changeset version && git add --all",
    "release": "bun run build && bunx --bun changeset publish",
    "check-types": "turbo run check-types --ui stream",
    "cli": "bun run -C packages/cli dev",
    "watch": "turbo run build --watch",
    "lint": "turbo run lint",
    "format": "oxfmt --write -c ./oxfmt.config.mts"
  },
  "dependencies": {
    "turbo": "^2.9.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@happy-dom/global-registrator": "^20.9.0",
    "@napi-rs/canvas": "^0.1.100",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.7.0",
    "bun-types": "^1.3.14",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.49.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.6"
}

