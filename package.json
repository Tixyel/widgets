{
  "name": "tixyel",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalogs": {
      "build": {
        "vite": "^8.3.4",
        "rollup-plugin-dts": "^6.5.1",
        "rollup": "^4.64.5"
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --ui stream",
    "build:client": "turbo run build -F @tixyel/streamelements build --ui stream",
    "build:cli": "turbo run build -F @tixyel/cli build --ui stream",
    "version": "bunx --bun changeset version && git add --all",
    "release": "bun run build && bunx --bun changeset publish",
    "check-types": "turbo run check-types --ui stream",
    "cli": "bun run -C packages/cli dev",
    "watch": "turbo run build --watch",
    "lint": "turbo run lint",
    "format": "oxfmt --write -c ./oxfmt.config.mts"
  },
  "dependencies": {
    "turbo": "^2.11.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@happy-dom/global-registrator": "^20.14.6",
    "@napi-rs/canvas": "^1.0.11",
    "@types/bun": "^1.4.3",
    "@types/node": "^25.9.9",
    "@typescript/typescript6": "^6.0.2",
    "bun-types": "^1.4.3",
    "concurrently": "^9.2.5",
    "oxfmt": "^0.72.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.6"
}
