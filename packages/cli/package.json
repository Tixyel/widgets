{
  "name": "@tixyel/cli",
  "version": "2.1.0",
  "description": "CLI tool for streamelements widgets",
  "keywords": [
    "cli",
    "widgets",
    "typescript",
    "server",
    "build"
  ],
  "author": {
    "name": "Tixyel",
    "email": "tixyelpvd@gmail.com",
    "url": "https://github.com/tixyel"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Tixyel/widgets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tixyel/widgets.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Tixyel/widgets/issues"
  },
  "type": "module",
  "private": false,
  "bin": {
    "tixyel": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "cross-env TIXYEL_VERSION=$npm_package_version tsc",
    "dev": "cross-env TIXYEL_VERSION=$npm_package_version tsc --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "autoprefixer": "^10.4.22",
    "commander": "^14.0.2",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "esbuild": "^0.25.12",
    "fast-glob": "^3.3.3",
    "html-minifier-terser": "^7.2.0",
    "inquirer": "^13.0.2",
    "javascript-obfuscator": "4.1.1",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/html-minifier": "^4.0.6",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/inquirer": "^9.0.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
