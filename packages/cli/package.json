{
  "name": "@tixyel/cli",
  "version": "3.0.0",
  "description": "CLI tool for streamelements widgets",
  "keywords": [
    "cli",
    "widgets",
    "typescript",
    "server",
    "build"
  ],
  "author": {
    "name": "Tixyel",
    "email": "tixyelpvd@gmail.com",
    "url": "https://github.com/tixyel"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Tixyel/widgets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tixyel/widgets.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Tixyel/widgets/issues"
  },
  "type": "module",
  "private": false,
  "bin": {
    "tixyel": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./api": {
      "types": "./dist/api.d.mts",
      "import": "./dist/api.mjs",
      "default": "./dist/api.mjs"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "cross-env TIXYEL_VERSION=$npm_package_version tsdown",
    "dev": "cross-env TIXYEL_VERSION=$npm_package_version tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "cli": "cross-env TIXYEL_VERSION=$npm_package_version bun run src/index.ts"
  },
  "dependencies": {
    "autoprefixer": "^10.4.22",
    "chokidar": "^3.6.0",
    "cli-spinners": "^3.4.0",
    "commander": "^14.0.2",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "esbuild": "^0.25.12",
    "fast-glob": "^3.3.3",
    "html-minifier-terser": "^7.2.0",
    "inquirer": "^13.0.2",
    "javascript-obfuscator": "4.1.1",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "ora": "^9.3.0",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/html-minifier": "^4.0.6",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/inquirer": "^9.0.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.12",
    "@typescript/native-preview": "^7.0.0-dev.20260216.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
